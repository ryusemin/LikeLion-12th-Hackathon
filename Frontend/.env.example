# 개인 설정이 필요하면 .env.development.local로 복사한 뒤 PC 환경에 맞게 수정하세요.
# REACT_APP_* 값은 브라우저에 공개되므로 API 키·비밀번호·서명키를 넣지 마세요.
# API 기본 주소에는 /api를 붙이지 마세요. 각 요청 경로에 이미 /api가 포함돼 있습니다.
REACT_APP_API_BASE_URL=http://127.0.0.1:8080
# SockJS 연결 주소이므로 ws(s)가 아닌 http(s)를 사용하세요.
REACT_APP_WS_URL=http://127.0.0.1:8080/ws/notification
# 사용자가 접속하는 프론트 주소입니다. 결제 완료 후 돌아올 주소를 만드는 데 사용합니다.
REACT_APP_APP_BASE_URL=http://127.0.0.1:3000
