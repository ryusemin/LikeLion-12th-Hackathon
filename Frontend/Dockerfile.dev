# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY .env.test ./
COPY public ./public
COPY src ./src
RUN npm run lint && npm run test:ci
EXPOSE 3000
CMD ["npm", "start"]
