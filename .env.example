# 루트 Compose에서만 사용하는 로컬 개발용 설정입니다.
# scripts/init-docker-env.ps1이 난수를 생성해 Git에서 제외된 .env에 저장합니다.
# Backend/nimn.env나 프론트 환경변수와는 별개이며, 실제 비밀값을 커밋하지 마세요.
DOCKER_MYSQL_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DOCKER_MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
DOCKER_JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY
