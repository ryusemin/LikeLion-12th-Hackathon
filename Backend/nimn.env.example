# 로컬 개발용 예제입니다. Backend/nimn.env로 복사하고 JWT 키는 직접 생성하세요.
# Java properties 형식으로 읽으므로 셸 명령이나 export를 넣지 마세요.
# 현재 Backend/nimn.env와 변수 이름을 맞췄으며, 실제 비밀값은 복사하지 않았습니다.
# 아래 spring.* 설정은 로컬 DB·Redis·SMTP를 사용하도록 연결 대상을 분리합니다.
# 배포 시에는 prod 프로필을 선택하고 배포 환경에서 실제 인증 정보를 주입하세요.
SPRING_PROFILES_ACTIVE=dev

# compose.yml의 로컬 데모 계정입니다. 운영 환경에서는 사용하지 마세요.
DATABASE_USERNAME=root
DATABASE_PASSWORD=pwd1234
# 이 값은 application.properties에 정의된 기본 DB 주소보다 우선합니다.
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/nimn_local?createDatabaseIfNotExist=true
spring.data.redis.host=127.0.0.1
spring.data.redis.port=6379

# 필수: HS256에 사용할 32바이트 이상의 난수를 생성해 Base64로 인코딩하세요.
JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY

# 외부 연동용 더미값입니다. 이 파일이 로컬 대체 서버를 실행해 주지는 않습니다.
OPENAI_API_KEY=local-placeholder
OPENAI_CHAT_MODEL=local-placeholder
OPENAI_CHAT_URL=http://127.0.0.1:18080/v1/chat/completions
OPENAI_IMAGE_MODEL=local-placeholder
OPENAI_IMAGE_URL=http://127.0.0.1:18080/v1/images/generations

# 기존 설정과 연결되므로 변수 이름의 대소문자를 그대로 유지하세요.
import_apiKey=local-placeholder
import_secretKey=local-placeholder

# 메일은 로컬로 연결합니다. 실제 발송을 확인하려면 로컬 SMTP 서버가 별도로 필요합니다.
GOOGLE_EMAIL=local@example.invalid
GOOGLE_APP_PASSWORD=local-placeholder
spring.mail.host=127.0.0.1
spring.mail.port=1025
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
